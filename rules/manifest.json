{
  "rules": [
    {
      "file": "adr-lifecycle.md",
      "match": "**/docs/adrs/*.md,**/decisions/*.md,ARCHITECTURE.md"
    },
    {
      "file": "agent-output-contracts.md",
      "match": "**/agents/*.md"
    },
    {
      "file": "astral-tool-overrides.md",
      "match": "*.py,pyproject.toml,uv.lock"
    },
    {
      "file": "ci-workflows.md",
      "match": ".github/workflows/**/*.yml"
    },
    {
      "file": "citation-requirements.md",
      "match": "SKILL.md,**/references/*.md,**/agents/*.md,**/commands/**/*.md,CLAUDE.md"
    },
    {
      "file": "data-format-selection.md",
      "match": "*.py,*.json,*.md,*.sql"
    },
    {
      "file": "delegation-format.md",
      "match": "SKILL.md,**/agents/*.md,**/commands/**/*.md,**/references/*.md"
    },
    {
      "file": "exception-handling.md",
      "match": "*.py,*.ts,*.js,*.mjs,*.cjs"
    },
    {
      "file": "frontmatter-requirements.md",
      "match": "SKILL.md,**/agents/*.md,**/commands/**/*.md"
    },
    {
      "file": "language-conventions.md",
      "match": "**/scripts/**,.claude/hooks/**,*.py"
    },
    {
      "file": "linting-exceptions.md",
      "match": "*.py,pyproject.toml"
    },
    {
      "file": "markdown-file-references.md",
      "match": "*.md"
    },
    {
      "file": "plugin-development.md",
      "match": "plugins/**/*,.claude-plugin/**/*"
    },
    {
      "file": "plugin-json.md",
      "match": "plugin.json"
    },
    {
      "file": "prose-file-classification.md",
      "match": "*.md"
    },
    {
      "file": "python-development.md",
      "match": "*.py,pyproject.toml,uv.lock"
    },
    {
      "file": "review-and-correction-discipline.md",
      "match": "SKILL.md,**/agents/*.md,**/commands/**/*.md,rules/**/*.md,AGENTS.md,CLAUDE.md"
    },
    {
      "file": "runtime-vs-design-time.md",
      "match": "SKILL.md,**/references/*.md,**/agents/*.md,**/commands/**/*.md,CLAUDE.md,AGENTS.md"
    },
    {
      "file": "script-invocation.md",
      "match": "**/scripts/**,.claude/hooks/**"
    },
    {
      "file": "shared-process-extraction.md",
      "match": "**/agents/*.md,SKILL.md"
    },
    {
      "file": "silent-failure-prevention.md",
      "match": "*.py,*.ts,*.js,*.mjs,*.cjs"
    },
    {
      "file": "skill-content-optimization.md",
      "match": "SKILL.md,**/references/*.md"
    },
    {
      "file": "skill-documentation-verification.md",
      "match": "SKILL.md,**/references/*.md"
    },
    {
      "file": "skill-substitution.md",
      "match": "SKILL.md"
    },
    {
      "file": "uv-run-required.md",
      "match": "**/scripts/**,*.py,.claude/hooks/**"
    },
    {
      "file": "yaml-toml-libraries.md",
      "match": "*.py"
    }
  ]
}
