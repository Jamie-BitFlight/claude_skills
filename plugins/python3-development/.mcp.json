{
  "mcpServers": {
    "sequential_thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"]
    },
    "cocoindex-code": {
      "command": "uvx",
      "args": [
        "--prerelease",
        "explicit",
        "--with",
        "cocoindex>=1.0.0a24",
        "--upgrade",
        "cocoindex-code"
      ]
    }
  }
}
