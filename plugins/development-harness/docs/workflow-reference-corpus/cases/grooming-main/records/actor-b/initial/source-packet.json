      "source_id": "swarm",
      "lines": [116, 140],
      "quote": "Take the last entry in\n  `sections['RT-ICA'].entries` whose `struck` is `false`."
    },
    {
      "id": "E36",
      "source_id": "swarm",
      "lines": [129, 140],
      "quote": "`BLOCKED-FOR-PLANNING` | Stop. Present the MISSING conditions. Do not proceed to Wave 3."
