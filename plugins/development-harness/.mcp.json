{
  "mcpServers": {
    "backlog": {
      "command": "uv",
      "args": ["run", "--python", "3.12", "--script", "scripts/run_backlog_server.py"],
      "cwd": ".",
      "env_vars": ["PWD", "CODEX_THREAD_ID"]
    },
    "sam": {
      "command": "uv",
      "args": ["run", "--python", "3.12", "--script", "scripts/run_sam_server.py"],
      "cwd": ".",
      "env_vars": ["PWD", "CODEX_THREAD_ID"]
    },
    "sequential_thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"]
    }
  }
}
